{
  "name": "grandaptive-starter",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env.local server/dev.ts",
    "test:db": "node scripts/check-database.ts",
    "check:connections": "node --env-file-if-exists=.env.local scripts/check-connections.ts",
    "test:live": "node --env-file-if-exists=.env.local scripts/check-live-backend.ts",
    "check:openai": "node --env-file-if-exists=.env.local scripts/check-openai.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
