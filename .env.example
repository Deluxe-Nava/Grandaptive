# Copiar a .env.local. No compartir claves en chat ni usar prefijo VITE_.
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32 bytes aleatorios como 64 caracteres hexadecimales; ver DESPLIEGUE.md.
SERVER_SECRET=
# Esta bandera NO configura CAPTCHA: activarlo realmente en Supabase Auth.
AUTH_CAPTCHA_ENABLED=false
# disabled: sin IA; mock: simulación; openai: peticiones facturables.
AI_MODE=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DAILY_LIMIT=15
AI_GLOBAL_DAILY_LIMIT=100
# Además: 100 intentos reales acumulados en PostgreSQL, sin reinicio automático.
