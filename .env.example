# Copiar a .env.local. No compartir claves en chat ni usar prefijo VITE_.
APP_ORIGIN=http://127.0.0.1:5173
# En Vercel Production: APP_ORIGIN=https://grandaptive.vercel.app (sin slash final).
# PORT sólo se utiliza en el servidor de desarrollo local.
PORT=3001
# Project URL de Connect: https://<referencia-del-proyecto>.supabase.co
# No pegar https://supabase.com/dashboard/project/...
SUPABASE_URL=
# Publishable key (sb_publishable_...); conservamos el nombre de variable del código.
SUPABASE_ANON_KEY=
# Secret key (sb_secret_...), exclusivamente servidor.
SUPABASE_SERVICE_ROLE_KEY=
# 32 bytes aleatorios como 64 caracteres hexadecimales; ver DESPLIEGUE.md.
SERVER_SECRET=
# Esta bandera NO configura CAPTCHA: activarlo realmente en Supabase Auth.
AUTH_CAPTCHA_ENABLED=false
# Excepción de demo solicitada: sólo cuentas con app_metadata.challenge_member=true.
# No abre registro público ni sustituye CAPTCHA para un lanzamiento con participantes.
AUTH_TEAM_DEMO_LOGIN=false
# disabled: sin IA; mock: simulación; openai: peticiones facturables.
AI_MODE=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DAILY_LIMIT=15
AI_GLOBAL_DAILY_LIMIT=100
# Sólo monitoreo de dependencias; no es la API key de UptimeRobot ni una clave Supabase.
# Generar 32+ caracteres aleatorios; UptimeRobot lo envía como Authorization: Bearer ...
MONITOR_TOKEN=
# Además: 100 intentos reales acumulados en PostgreSQL, sin reinicio automático.
